# Database connection string
# Option A (Local embedded postgres): postgres://postgres:postgres@localhost:55432/drishti
# Option B (Supabase transaction pooler): postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgres://postgres:postgres@localhost:55432/drishti"

# Direct URL for Prisma migrations & db push (Required if using connection poolers like Supabase)
DIRECT_URL="postgres://postgres:postgres@localhost:55432/drishti"

# Better Auth Configuration
BETTER_AUTH_SECRET="change-this-to-a-secure-random-string-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3005"
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# File storage (UploadThing - optional, leave placeholder or empty if using local storage)
UPLOADTHING_TOKEN=""

# Email Notifications via SMTP (optional — leave empty to disable email notifications)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey_or_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="noreply@example.com"

# Cron endpoint protection
CRON_SECRET="change-this-to-a-secure-cron-secret"

# AI Integration (optional — local Ollama server, e.g. http://localhost:11434)
OLLAMA_URL=""
OLLAMA_MODEL="llama3.2"

# Dev email override — redirects ALL emails to this address during local development.
# Leave empty in production.
DEV_EMAIL_OVERRIDE="dev@example.com"
